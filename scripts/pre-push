#!/bin/sh
# Auto-sync engine to origin/engine on git push
CURRENT_BRANCH=$(git branch --show-current)
if [ "$CURRENT_BRANCH" != "content" ] && [ "$CURRENT_BRANCH" != "engine" ]; then
    CHANGED=$(git diff --name-only origin/engine..HEAD 2>/dev/null | grep -E '^(site/engine/|site/config/)')
    if [ -n "$CHANGED" ]; then
        echo ""
        echo "=========================================================="
        echo "[Kirby Engine] Detekovana zmena v backendu (engine/config)!"
        echo "[Kirby Engine] Automaticky odesilam zmeny do vetve origin/engine..."
        echo "=========================================================="
        git push origin HEAD:refs/heads/engine --quiet 2>/dev/null
        echo "[Kirby Engine] Vetev origin/engine byla uspesne zaktualizovana."
        echo "=========================================================="
        echo ""
    fi
fi
exit 0
