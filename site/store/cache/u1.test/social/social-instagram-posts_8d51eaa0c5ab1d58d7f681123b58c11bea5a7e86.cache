TS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=_p2J5lA1sgwQ7kNvwGmjMgX&_nc_oc=AdqfjOeE2rK3iYmcAI-Hj2Vn2LwpTdVc4MGnwGOq9L1uv5BJEnP_gjKhb9JEjNKOGfM&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQLQqWYzmPxq0B70vGrpAfRf3af1JnSXDGonHS6_5tmZfI4w8v7gexC6uu-N5w9jajuFIaORvCMiaw&oh=00_AQH3Dg0LBW76TbJ8Sz6IcvF8NPLAy4OSAQ6u99imDvUcRA&oe=6A8DCB06","permalink":"https:\/\/www.instagram.com\/p\/C6ByZSoIZA8\/","timestamp":"2024-04-21T15:05:56+0000"},{"id":"18115986799363542","caption":"Chyb\u00ed v\u00e1m v kancel\u00e1\u0159i relax z\u00f3na, ve kter\u00e9 byste vypnuli?\n\nTak to budete z\u00e1vid\u011bt zam\u011bstnanc\u016fm @lobeylabs. Co \u0159\u00edk\u00e1te na na\u0161i realizaci t\u011bchto unik\u00e1tn\u00edch kancel\u00e1\u0159\u00ed? \u261d\ufe0f","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/490598553_1282428733614465_1408759092415469072_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=mCAb5aN4fTkQ7kNvwE26Lgq&_nc_oc=AdpPid21UZVEPevDLFj9F6B2AMCHu7VD50ozPTruVtqtb5iLDbtwJWCmRarg4tZ_zQQ&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQLDC76Yxr9H5nw9SPuo5dWsQMD42ZE41Km8lKRaQGriyNRa8ZkFTzMLuTt0BFx1OAxRypYivKGKsg&oh=00_AQGbiiVo0fQB8tis8kPfnSK5uUk52Wu-NLTJZry9tG81PQ&oe=6A8DDFDC","permalink":"https:\/\/www.instagram.com\/p\/C47j4ORIrWF\/","timestamp":"2024-03-25T08:32:15+0000"},{"id":"18256021156211448","caption":"Minul\u00fd p\u00e1tek se pro n\u00e1\u0161 t\u00fdm stal osudov\u00fdm \u2013 vyzkou\u0161eli jsme si \u017eidle RIM CZ, ze kter\u00fdch, jak tvrd\u00ed v\u00fdrobce, nebudete cht\u00edt vst\u00e1t. A je to pravda. \ud83d\ude42\n\nA na \u010dem sed\u00edte v pr\u00e1ci vy?","media_type":"IMAGE","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/490181900_1281795130344492_8024405127061111044_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=111&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=gkkYvWmD6koQ7kNvwFOyk52&_nc_oc=Adquc--fbExGzjwRJtWDacjAEfPqcohoiw7WqjEOvk6C6qeg542PrwW7F3IT_NlmaRU&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQJE2XoIioJQfdjf7oGXdltqAHG4KL6xDVbyeZwnDoTJPTAfQA5DE9EYGv6N5wAa-XLQQ82tq_1C0w&oh=00_AQHGl9gVNFCGiNd7OL35Rub184MyES_hMi2LoXGL7TjcBQ&oe=6A8DEF5C","permalink":"https:\/\/www.instagram.com\/p\/C4fdYqooWHb\/","timestamp":"2024-03-14T10:36:47+0000"},{"id":"18041634544709187","caption":"A kam se v kancel\u00e1\u0159\u00edch usad\u00edte vy? \ud83e\udd14\n\nPreferujete rad\u011bji klid a pr\u00e1ci o samot\u011b nebo byste nemohli b\u00fdt d\u00e1l ne\u017e 2 metry od sv\u00fdch koleg\u016f?\n\n #u1 #design #interiordesign #office","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/490022076_1281346767055995_6191066792426050943_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=pwHDUeruQOoQ7kNvwFzgWyD&_nc_oc=AdqMoGPv_gP2AWFA1vmvwQX6uLeV0flgeQp7ZQYk0qHoBXhV7qrI3Tmkns74cmglRw0&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQJeJmEIE8GArk-9Yiv-9u6VS1XxOk1uJW5mIejG4XaAVm1kDqWq5odAUKFzINzhrOrWqYjd1IBEIA&oh=00_AQGb4qLOwkTdFqlx8V2pxK8EiZMHtItkkWDAAYtgz9HAhA&oe=6A8DE341","permalink":"https:\/\/www.instagram.com\/p\/C321veqicgF\/","timestamp":"2024-02-27T16:00:44+0000"},{"id":"18172947463288272","caption":"Pro na\u0161e zam\u011bstnance m\u00e1me nov\u011b k dispozici vozy VW Passat. \n\nObchodn\u00edk\u016fm u\u017e zp\u0159\u00edjem\u0148uj\u00ed pracovn\u00ed cesty a n\u00e1\u0161 marke\u0165\u00e1k u\u017e jedno z nov\u00fdch aut otestoval v nedalek\u00e9m sob\u011b\u0161ick\u00e9m ter\u00e9nu. \u26f0\ufe0f\n\nAut m\u00e1me dostatek a hled\u00e1me i lidi, kte\u0159\u00ed s nimi budou jezdit. \nPod\u00edvejte se na otev\u0159en\u00e9 pozice na na\u0161em webu. \ud83d\udcbc\n\nOdkaz najdete v BIU. \ud83d\udc46\n\n #hiring #hiringnow #work #u1 #design","media_type":"IMAGE","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/490233458_1280463590477646_7049904432336136820_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=103&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiRkVFRC5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=inHfa_DkSz0Q7kNvwFyJvyq&_nc_oc=AdrT-fvOLs_BZAuKfq09ds7XSM-uhwIgb47pOLzE1tyIDtaOVl-Z896EkZhI1dSf4iM&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQKk-jgWhKX2o6TrU3I-AXH5-QEhn91dJwsbA8LGgYR7Xwr-1fP58nyTfX6sdx4BWFIp37MEhSB9Gg&oh=00_AQFEl1G7zQRg0p2y8AXNKCMdlefTWGNiGfAH7iF2dkOg6Q&oe=6A8DE031","permalink":"https:\/\/www.instagram.com\/p\/C3DIG6Stjrk\/","timestamp":"2024-02-07T14:00:43+0000"},{"id":"17951616020744093","caption":"Realizovali jsme rekonstrukci call centra pro nejv\u011bt\u0161\u00ed \u010deskou t\u011b\u017eebn\u00ed spole\u010dnost MND. \u26cf\ufe0f\n\nZam\u011b\u0159ili jsme se na jednotn\u00fd vizu\u00e1ln\u00ed dojem a propojen\u00ed s firemn\u00edm posl\u00e1n\u00edm. \n\nKancel\u00e1\u0159 zam\u011bstnanc\u016fm nab\u00eddne klid ve spole\u010dn\u00fdch prostor\u00e1ch, kuchy\u0148ku s j\u00eddelnou a netradi\u010dn\u00ed z\u00e1v\u011bsn\u00e9 rostliny v centr\u00e1ln\u00ed hale. \ud83c\udf31\n\nCo na ni \u0159\u00edk\u00e1te? \ud83d\udc47\n\n #czechdesign #colorfulloffice #interiordesign #office #work","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/489584785_1280463743810964_1386619057064985741_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=100&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=ceBVwN_eVDQQ7kNvwFQFnIt&_nc_oc=Ado5ySAJ48Z_pkiG0e5_QtVdUBP31kI2_JmZMkTh0ijy4rPlIq9lFHJ_047LktfRF1E&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQJ9_kXiDR1f4VDhv9r8rK8-D77rJ7kJ4Xe-COn2sATPgj69v_1p0NIFl7oKrZJOG7_ygLdcsQA0DA&oh=00_AQF9lKS80hxfClfHulsLtJGLDe1wTBSFf1VOrLjv15h88A&oe=6A8DDB63","permalink":"https:\/\/www.instagram.com\/p\/C2_zPicvGP-\/","timestamp":"2024-02-06T07:00:40+0000"},{"id":"18096116254385755","caption":"Nepracujeme jen v modern\u00edch kancel\u00e1\u0159sk\u00fdch budov\u00e1ch. \ud83c\udfd9\ufe0f\n\nV U1 jsme vybo\u010dili z tradi\u010dn\u00edch kolej\u00ed office park\u016f a realizovali modern\u00ed kancel\u00e1\u0159e v historick\u00e9 budov\u011b v centru Brna.\n\nUnik\u00e1tn\u00ed sv\u00edtidla, vyu\u017eit\u00ed barev pro lep\u0161\u00ed orientaci a spole\u010dn\u00e9 prostory. To je prvn\u00ed patro kancel\u00e1\u0159\u00ed @purple.team.life \ud83d\udc9c","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/489471892_1279725877218084_5917795698274678021_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=101&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=nvu74yFRsaAQ7kNvwE5c5Kn&_nc_oc=AdoE51-205xy7EfympP93bxjiCjZcwBsx3Wdjh0QsnsgegiIjW11xtQ9LVr4DXycaNA&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQKAqk_R7o96rKDlVpTPj1Gu7445psyuRO57QC0hbL7yZvvn-mrfz54J2zFMVWExgTLfYCbl_Z54MQ&oh=00_AQHoa6vYY1DiEgP7WITXwyvd8-qFIKeUH0UvG2t1Bj0zDg&oe=6A8DD4A2","permalink":"https:\/\/www.instagram.com\/p\/C2dCcfBIfli\/","timestamp":"2024-01-23T19:00:06+0000"},{"id":"18001311002154681","caption":"R\u00e1di jsme byli sou\u010d\u00e1st\u00ed dobro\u010dinn\u00e9 akce pro centrum Klok\u00e1nek. Dohromady se vybralo p\u0159es 2 miliony korun a Klok\u00e1nek tak m\u016f\u017ee rekonstruovat byty, ve kter\u00fdch d\u011bti bydl\u00ed. My jsme dodali to, co um\u00edme nejl\u00e9pe - n\u00e1bytek. Skv\u011bl\u00fd po\u010din t\u00fdmu @micanek_motorsport. D\u011bkujeme! \ud83d\udc4d","media_type":"VIDEO","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/o1\/v\/t2\/f2\/m82\/AQPjbSQ7p4FYT1XSyWncfrxR5MJA3Bge8YxdG5lO_3w7CReUihw5UF4IgQ8ojEL_Rh91KWiq4HMgsTA52vxaxqyr6sNxO5fiRr99BOo.mp4?_nc_cat=101&_nc_sid=5e9851&_nc_ht=scontent-prg1-1.cdninstagram.com&_nc_ohc=1nltBZuM6dIQ7kNvwEmk_cO&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNDgwLmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MTM5MzIzODYxNzk3NDMxNCwiYXNzZXRfYWdlX2RheXMiOjk0MSwidmlfdXNlY2FzZV9pZCI6MTAwOTksImR1cmF0aW9uX3MiOjM0LCJ1cmxnZW5fc291cmNlIjoid3d3In0%3D&ccb=17-1&vs=fe5082fc23b2b1bf&_nc_vs=HBksFQIYT2lnX3hwdl9yZWVsc19wZXJtYW5lbnRfcHJvZC9EMDQzODYxMTFDQjZBNzYwQjRGQkJEQUM0RUJENzk5RV92aWRlb19kYXNoaW5pdC5tcDQVAALIARIAFQIYOnBhc3N0aHJvdWdoX2V2ZXJzdG9yZS9HQ0V0SVJsUzZXUmlwVklGQU5kNjVxYmtwYVJHYnFfRUFBQUYVAgLIARIAKAAYABsCiAd1c2Vfb2lsATEScHJvZ3Jlc3NpdmVfcmVjaXBlATEVAAAm1JjLzpTJ-QQVAigCQzMsF0BBV87ZFocrGBJkYXNoX2Jhc2VsaW5lXzFfdjERAHX-B2XmnQEA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&edm=ANo9K5cEAAAA&_nc_zt=28&_nc_tpa=Q5bMBQKBbfEPF4d0XYj9mt07vGGOhSZI6s0-2sJ3xoLzUBuqEsN27TfexE0eZDq8h_g-7L9RhcgdeT1KDg&oh=00_AQGn7Y4qdYrxZLhxDiwNwlAg5199gae-MqOjo4lXmnKQcg&oe=6A89ED7E","permalink":"https:\/\/www.instagram.com\/reel\/C2Z2ji7sCyp\/","timestamp":"2024-01-22T13:21:21+0000","thumbnail_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t51.71878-15\/503307812_1712602452704594_1592257911231426811_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0xJUFMuYmVzdF9pbWFnZV91cmxnZW4uQzMifQ%3D%3D&_nc_ohc=Y6XzxU4d-JoQ7kNvwETw65K&_nc_oc=AdpBRchdPlJ7eC0zCxyLDLXb5_5Ep-HaF_ZSK-QirkLtXTbGq18b0rbLhVki8r3SZv8&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQLJyQNqrMejL9Gsb_BxlnNjddPuabXr_HtbNznHRZFz54WYBuIDCAk3UR7EIJI0rZnwkf3cDm319w&oh=00_AQHGL5myHthUUB4wYPyM7iQbeE5F-v1fKmw-lxW3iqKrdA&oe=6A8DC6BD"},{"id":"17992809077312402","caption":"Mlad\u00e1, kreativn\u00ed firma a kancel\u00e1\u0159e na Vln\u011bn\u011b? Nov\u00e9 kancel\u00e1\u0159e pro spole\u010dnost STRV @strvcom kladou d\u016fraz na inovaci a spole\u010densk\u00e9 interakce. \n\nJednotliv\u00e9 z\u00f3ny jsme navrhli tak, aby se do sebe prol\u00ednaly. Do kancel\u00e1\u0159\u00ed jsme pustili spoustu denn\u00edho sv\u011btla a otev\u0159eli v\u00fdhled na Brno. \ud83c\udfd9\ufe0f\n\nKombinace otev\u0159en\u00fdch prostor a sv\u011btl\u00e9ho prost\u0159ed\u00ed podporuje zam\u011bstnance v setk\u00e1v\u00e1n\u00ed, vym\u00fd\u0161len\u00ed a sd\u00edlen\u00ed n\u00e1pad\u016f. \n\nVizu\u00e1ln\u00ed styl odpov\u00edd\u00e1 hodnot\u00e1m STRV \u2013 jednoduch\u00fd, minimalistick\u00fd, p\u0159esto hrav\u00fd. \ud83e\uddf8 \n\nFotograf: Jan Kud\u011bj @jankudej","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/489782707_1279564777234194_5954795002837361591_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=107&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=w9gdlkQTT5UQ7kNvwHfVmKm&_nc_oc=AdrbBiin8cvn2_Dbt0MWWbe2gN_eVx2DGPWoVvkD9q6iu_LrjFmpWlxa6kzlBak2f4Y&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQI1NK6Mv758QFzxcjHcowQQmqrh7ZSus8g4RMFtPxvLwyHSmWjtMdo04PRYp4UIZ2Odbci9Yik1dg&oh=00_AQEhFWgv1PLT0-43dZ4R92f3HyZ6YSOe9BDMEVR3fQu4sA&oe=6A8DC4E1","permalink":"https:\/\/www.instagram.com\/p\/C2NluoDhsWB\/","timestamp":"2024-01-17T19:00:33+0000"},{"id":"18008873216325598","caption":"Pro p\u0159edn\u00edho dodavatele bezpe\u010dnostn\u00edch syst\u00e9m\u016f na \u010desk\u00e9m i zahrani\u010dn\u00edm trhu, spole\u010dnost Trade FIDES, a.s., jsme navrhli interi\u00e9r i exteri\u00e9r v\u00fdrobn\u00ed, skladovac\u00ed a kancel\u00e1\u0159sk\u00e9 budovy. V jednom. \ud83d\udd11\n\nInteri\u00e9r spl\u0148uje specifick\u00e9 po\u017eadavky spole\u010dnosti \u2013 V p\u0159\u00edzem\u00ed se nach\u00e1z\u00ed v\u00fdrobn\u00ed a skladovac\u00ed \u010d\u00e1st budovy, v 1. Pat\u0159e potom \u010d\u00e1st kancel\u00e1\u0159sk\u00e1.\n\nDesign je postaven na respektu k lokalit\u011b objektu a jeho industri\u00e1ln\u00ed minulosti. N\u00e1bytek jsme sladili do neutr\u00e1ln\u00edho stylu s barevn\u00fdmi akcenty tak, aby vzniklo kulturn\u00ed a p\u0159\u00edjemn\u00e9 pracovn\u00ed prost\u0159ed\u00ed nejen v kancel\u00e1\u0159\u00edch, ale i ve v\u00fdrobn\u00ed \u010d\u00e1sti budovy.\n\nPr\u00e1ci bude zam\u011bstnanc\u016fm zp\u0159\u00edjem\u0148ovat nejen v\u0161udyp\u0159\u00edtomn\u00e1 zele\u0148 v okol\u00ed, ale tak\u00e9 spousta denn\u00edho sv\u011btla v interi\u00e9ru, kter\u00e9 dod\u00e1v\u00e1 cel\u00e9mu prostoru p\u0159irozenou energii. \u2600\ufe0f\n\nFotograf: Jan Kud\u011bj @jankudej","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t51.82787-15\/655855508_18146530039463329_7974028583787138010_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=100&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=xXT6gXRIgmwQ7kNvwESRMIg&_nc_oc=Adp-meMorxDdVSoSYUmc-KOJqlQuRerk96udHSM_dYSO6MQMzu_lTbvGujSCdHuapIA&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQKvhlJTXAh1-7m23HHUQtxOlyL9HOOfnnvpC8oUGDl_vwFZxu7HhD2dDsUL4tT0mH46sngRAQpaWw&oh=00_AQGFR2FVFuGBMvL88l4zk6R1y3p6miIKcI7zUetUF2x0ng&oe=6A8DC491","permalink":"https:\/\/www.instagram.com\/p\/C2HadcLNf1u\/","timestamp":"2024-01-15T09:26:39+0000"},{"id":"18029280679837465","caption":"Jsme r\u00e1di, \u017ee m\u016f\u017eeme pom\u00e1hat. V r\u00e1mci dobro\u010dinn\u00e9 sb\u00edrky od @jiri_micanek jsme krom\u011b finan\u010dn\u00ed podpory 50 000 korun dodali vybaven\u00ed n\u00e1bytkem v hodnot\u011b 250 000 korun pro brn\u011bnsk\u00e9ho Klok\u00e1nka. \n\nP\u016fvodn\u00ed aukce helmy se rychle zm\u011bnila ve sb\u00edrku na dobrou v\u011bc a n\u00e1m bylo ct\u00ed se \u00fa\u010dastnit. Nen\u00ed toti\u017e nic d\u016fle\u017eit\u011bj\u0161\u00edho, ne\u017e pomoci lidem v nouzi. \n\nCentrum Klok\u00e1nek, kter\u00e9 pom\u00e1h\u00e1 ohro\u017een\u00fdm d\u011btem, m\u016f\u017ee d\u00edky neo\u010dek\u00e1van\u011b vysok\u00e9 \u010d\u00e1stce m\u00edsto pl\u00e1novan\u00fdch \u00faprav zahrady renovovat byty, ve kter\u00fdch d\u011bti v nouzi bydl\u00ed. \ud83c\udfe1\n\nDo nov\u00e9ho roku tak m\u016f\u017eeme vykro\u010dit nejen se skv\u011bl\u00fdm v\u00fdsledkem roku minul\u00e9ho, ale i s dobr\u00fdm skutkem pro ty, kte\u0159\u00ed to opravdu pot\u0159ebuj\u00ed. \ud83c\udf40","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t51.82787-15\/653401222_17984671919966726_1853499018954463496_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=102&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=xFcuexx82r4Q7kNvwHmAANx&_nc_oc=AdqZkOlCYlK537MGKbI5r5VbuF2o_BJzDiOrApc1YSgbknTMY1dLGtQwm1kIbDGmGl4&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQLRxDXKxdQUzey7nN-ms4LZgEdwDJakaUhYFWgO-eWTt9wV7O3_D3sgbk8MA3mYXnA98ROuhjvQ2Q&oh=00_AQHT8wB9iyds7SlWZSckJl2JVwCTrp4s9vmwnrvuqSvNoQ&oe=6A8DD8C1","permalink":"https:\/\/www.instagram.com\/p\/C2FmagxtQWy\/","timestamp":"2024-01-14T16:32:37+0000"},{"id":"18093029305353698","caption":"Co \u0159\u00edk\u00e1 o nov\u011b dokon\u010den\u00e9m projektu pro developerskou spole\u010dnost @msinvestcz na\u0161e design\u00e9rka Monika? \ud83e\uddcf\ud83c\udffc\u200d\u2640\ufe0f\n\n\u201eDesignov\u00e9 \u0159e\u0161en\u00ed bylo od za\u010d\u00e1tku inspirov\u00e1no logem spole\u010dnosti. Barevnost a interi\u00e9rov\u00fd design jsme sladili tak, aby ka\u017ed\u00fd koutek t\u011bchto kancel\u00e1\u0159\u00ed odr\u00e1\u017eel profesion\u00e1ln\u00ed a p\u0159\u00edv\u011btivou atmosf\u00e9ru. Na\u0161\u00edm c\u00edlem bylo zajistit, aby zam\u011bstnanci m\u011bli nejen ide\u00e1ln\u00ed pracovn\u00ed podm\u00ednky, ale tak\u00e9 aby se c\u00edtili pohodln\u011b.\"\n\n#u1spacedesign #interiordesign #developer #reception #wooddesign","media_type":"CAROUSEL_ALBUM","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/v\/t39.30808-6\/362915077_18270589393144339_4336618601843392605_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=104&ccb=7-5&_nc_sid=18de74&efg=eyJlZmdfdGFnIjoiQ0FST1VTRUxfSVRFTS5iZXN0X2ltYWdlX3VybGdlbi5DMyJ9&_nc_ohc=JNDgtuRXmuwQ7kNvwGllyoU&_nc_oc=AdpNJQkEPKAX8EzIuc-40sXgIHGPwIXXWvVLrZVSHadmslJY-pDiXApBwoWeiquGuMY&_nc_zt=23&_nc_ht=scontent-prg1-1.cdninstagram.com&edm=ANo9K5cEAAAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&_nc_tpa=Q5bMBQKXOJnaXSha-BagnWFK3yBr_7uBt8f4CBqlAP2dybFuEpMqFkRtlDuqEDNNGvIg7CP7EQVVpvHi2g&oh=00_AQFiz1TOSNhElGR7Z-FY11XmsOqGYfkP4wFbSdzBkcAk0w&oe=6A8DF6AB","permalink":"https:\/\/www.instagram.com\/p\/CvFEfzoLNgE\/","timestamp":"2023-07-24T11:56:30+0000"},{"id":"17979525029363661","caption":"Poj\u010fme si p\u0159ipomenout, kde se v Brn\u011b pracuje na 100% p\u0159\u00edrodn\u00ed \u010desk\u00e9 kosmetice \ud83c\udf31\ud83c\udf3c\n\n\u2022 credit to @lobeylabs\n\n#u1spacedesign #offices #interiordesign #nature #naturalcosmetics #prirodnikosmetika #lobey","media_type":"VIDEO","media_url":"https:\/\/scontent-prg1-1.cdninstagram.com\/o1\/v\/t2\/f2\/m82\/AQMioOAggWUAjai-yKq_DaoQmXajvgfVQKGcvxcP1f1LU3vSSTjs3AHjP_S7Kbv6JFwPV7HIqZ8n5U61PmQIYJh8jgDDX4fLeODvx3U.mp4?_nc_cat=108&_nc_sid=5e9851&_nc_ht=scontent-prg1-1.cdninstagram.com&_nc_ohc=w4XQqmU2_JAQ7kNvwF-TZ4E&efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5JTlNUQUdSQU0uQ0xJUFMuQzMuNTc2LmRhc2hfYmFzZWxpbmVfMV92MSIsInhwdl9hc3NldF9pZCI6MzUzNjY4NzkwOTk4MjIyOSwiYXNzZXRfYWdlX2RheXMiOjExMjgsInZpX3VzZWNhc2VfaWQiOjEwMDk5LCJkdXJhdGlvbl9zIjo0NiwidXJsZ2VuX3NvdXJjZSI6Ind3dyJ9&ccb=17-1&vs=f45c4e03f9f05867&_nc__gdl5p0BAA&_nc_gid=8G-8Y1KcLepIkJJUVq_mnw&edm=ANo9K5cEAAAA&_nc_zt=28&_nc_tpa=Q5bMBQIU1FMl6nhvwrOdcx83fTbw-c2fgkm5eNITY-qdGdMyoUtXhOuU6MwCCkTfzuDNhCRCtD1Cs3Zmrg&oh=00_AQEWgKd24Yjtar5W0LhUzQRwB04i1s-6IhMjxLOfRQT6rQ&oe=6A89E2A5","permalink":"https:\/\/www.instagram.com\/reel\/Cu35hwvPodi\/